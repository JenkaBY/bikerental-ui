# handoff plugin configuration. Commit this file.
# Flat KEY=VALUE so that both bash scripts and humans can read it.
HANDOFF_PROTOCOL=1
HANDOFF_REPO=JenkaBY/bikerental-ui
HANDOFF_PEERS="JenkaBY/bike-rental"
HANDOFF_MAX_DEPTH=3
HANDOFF_STALE_DAYS=3
HANDOFF_LABEL_TASK=agent-task
HANDOFF_LABEL_PREFIX=handoff:
HANDOFF_LABEL_PARENT=handoff:parent
